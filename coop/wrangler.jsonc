{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "knock-coop",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PorchRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PorchRoom"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "2026101301", "simple": { "limit": 5, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "2026101302", "simple": { "limit": 30, "period": 60 } }
  ]
}
