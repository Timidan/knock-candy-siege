  "meta": {
    "app": "Candy Siege Chog aura drawing masters",
    "version": "1",
    "image": "chog-aura.png",
    "format": "RGBA8888",
    "scale": "1",
    "padding": 2,
    "animation": {
      "frames": [
        0,
        1,
        2,
        3
      ],
      "frameRate": 6,
      "repeat": -1,
      "note": "Four distinct registered frames; two bent cels drift through a four-step loop. Identical trimmed cels share texture rectangles."
    },
    "aura": {
      "slot": "aura",
      "blend": "normal",
      "placement": "Behind head and body, in 256x320 registered space."
    },
    "specialForms": {
      "skull": {
        "whenAny": [
          {
            "Form": "Skull"
          },
          {
            "Base": "Skull"
          }
        ],
        "frame": "form/skull/face",
        "replaces": [
          "base/face"
        ],
        "omit": [
          "base/nose",
          "mouth/placeholder"
        ],
        "keep": [
          "base/back",
          "base/blush",
          "eyes"
        ],
        "tint": "skin",
        "note": "Multiply neutral bone pixels by skins[Skin].tint, including red and yellow skeletons whose ordinary face swatch is cream. Sockets accept eye layers at the template anchors. Keep authored mouth traits above the teeth; omit only the default mouth. Fur stays on base/back."
      },
      "radioactive": {
        "when": {
          "Base": "Radioactive"
        },
        "frames": [
          "form/radioactive/glow/0",
          "form/radioactive/glow/1",
          "form/radioactive/glow/2",
          "form/radioactive/glow/3"
        ],
        "after": "aura",
        "before": "head-back",
        "replaces": [],
        "blend": "normal",
        "note": "Green toxic halo and drips behind head/body; retain the NFT aura and all base layers. No global green tint."
      }
    },
    "skinOverlays": {
      "metal": {
        "when": {
          "Skin": "Metal"
        },
        "frame": "skin/metal/shine",
        "after": "base/face",
        "before": "base/blush",
        "clip": "selected face alpha",
        "tint": null,
        "blend": "normal"
      },
      "jade": {
        "when": {
          "Skin": "Jade"
        },
        "frame": "skin/jade/shine",
        "after": "base/face",
        "before": "base/blush",
        "clip": "selected face alpha",
        "tint": null,
        "blend": "normal"
      },
      "multi": {
        "when": {
          "Skin": "Multi Colored"
        },
        "frame": "skin/multi/stripes",
        "after": "base/back",
        "before": "base/face",
        "tint": "skin",
        "clip": "fur and onesie alpha; exclude face/hands/feet",
        "blend": "normal",
        "note": "Multiply bands by skins[Skin].tint, or the current skins[Skin].cycle colour. The cream face remains unchanged. Body bands register to the template onesie; mask to the actual costume."
      }
    },
